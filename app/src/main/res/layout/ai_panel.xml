<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only
    AI rewrite panel, replaces the keyboard while open (sibling of the clipboard / emoji views).
-->
<helium314.keyboard.keyboard.ai.AiPanelView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/ai_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:padding="10dp"
            android:textSize="16sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ai_proofread"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/ai_proofread" />

        <Button
            android:id="@+id/ai_formal"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/ai_formal" />

        <Button
            android:id="@+id/ai_casual"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/ai_casual" />

        <Button
            android:id="@+id/ai_human"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/ai_human" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ai_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="20sp"
            android:text="✕"
            android:contentDescription="@android:string/cancel" />

        <Button
            android:id="@+id/ai_apply"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:text="✓"
            android:contentDescription="@android:string/ok" />
    </LinearLayout>
</helium314.keyboard.keyboard.ai.AiPanelView>
