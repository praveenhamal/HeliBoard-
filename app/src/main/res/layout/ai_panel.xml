<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only
    AI rewrite panel, replaces the keyboard while open (sibling of the clipboard / emoji views).
-->
<helium314.keyboard.keyboard.ai.AiPanelView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <!-- Action buttons at the TOP, safe from soft navigation keys -->
    <LinearLayout
        android:id="@+id/ai_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ai_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:paddingHorizontal="6dp"
            android:layout_marginEnd="4dp"
            android:textSize="18sp"
            android:text="✕"
            android:contentDescription="@android:string/cancel" />

        <Button
            android:id="@+id/ai_proofread"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/ai_proofread" />

        <Button
            android:id="@+id/ai_formal"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/ai_formal" />

        <Button
            android:id="@+id/ai_casual"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/ai_casual" />

        <Button
            android:id="@+id/ai_apply"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:paddingHorizontal="6dp"
            android:textSize="18sp"
            android:text="✓"
            android:contentDescription="@android:string/ok" />
    </LinearLayout>

    <!-- Scrollable preview text box -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/ai_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:padding="10dp"
            android:textSize="16sp" />
    </ScrollView>

</helium314.keyboard.keyboard.ai.AiPanelView>
